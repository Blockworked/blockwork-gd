# Copy to .env and point these at your machine.
# xwin "splat" output with crt/ and sdk/ (Windows SDK for cross-compiling).
SPLAT_DIR=/path/to/splat
# CMake toolchain file for clang-cl targeting MSVC.
TOOLCHAIN=/path/to/clang-cl-msvc.cmake
# A Blockwork checkout; blockwork-ffi is built from it.
BLOCKWORK_REPO=../Blockwork
